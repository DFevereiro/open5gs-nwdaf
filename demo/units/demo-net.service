[Unit]
Description=Demo: UPF tunnel interface (ogstun) and NAT for UE traffic
Before=open5gs-upfd.service
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'ip link show ogstun >/dev/null 2>&1 || ip tuntap add name ogstun mode tun; \
  ip addr replace 10.45.0.1/16 dev ogstun; ip link set ogstun up; \
  sysctl -qw net.ipv4.ip_forward=1; \
  iptables -t nat -C POSTROUTING -s 10.45.0.0/16 ! -o ogstun -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -s 10.45.0.0/16 ! -o ogstun -j MASQUERADE'

[Install]
WantedBy=multi-user.target
